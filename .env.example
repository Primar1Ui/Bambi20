# =============================================================
# Environment variables
# Copy this file to .env.local for local development, and add the
# same variables in the Vercel dashboard for production.
# =============================================================

# Supabase — powers the contact form AND newsletter signup.
# Find these in: Supabase Dashboard > Project Settings > API
#   - Project URL  -> NEXT_PUBLIC_SUPABASE_URL
#   - anon public  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Resend — email notifications when someone contacts you or subscribes.
# Find the API key in: https://resend.com/api-keys
# Without these, forms still save to Supabase — you just won't get an email ping.
RESEND_API_KEY=re_xxxx
NOTIFY_EMAIL=davidtosin306@gmail.com
# Use onboarding@resend.dev until you verify your own domain.
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Google Search Console — HTML tag verification (optional).
# Search Console > Settings > Ownership verification > HTML tag > copy the content value only.
GOOGLE_SITE_VERIFICATION=your_google_verification_code

# LinkedIn profile URL — included in Person schema sameAs when set (optional).
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-profile
